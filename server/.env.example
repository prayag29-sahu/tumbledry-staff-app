# Tumbledry Server — Environment Variables
# This file contains PLACEHOLDER NAMES ONLY — no real credentials.
# Copy to .env for local development (never commit .env to Git).
# Set production values in the Render dashboard as secret environment variables.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Use the Supabase Session Pooler URL for the app runtime (Transaction pooler for Prisma).
# Use the Direct connection URL for Prisma Migrate (migrations require a direct connection).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── JWT signing secrets ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters each; never share or commit real values.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of exact allowed origins (no trailing slash).
# In production: use your owned frontend domain, NOT vercel.app if using cookies.
CORS_ORIGIN=http://localhost:3000

# ─── Supabase Storage (server-side only) ─────────────────────────────────────
# Service role key MUST NEVER go to the frontend or Git. Render secrets only.
SUPABASE_STORAGE_URL=https://[PROJECT-REF].supabase.co/storage/v1
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET_PROFILES=profiles
SUPABASE_BUCKET_ATTENDANCE=attendance
SUPABASE_BUCKET_DAMAGE=damage

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
